<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="RoundShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="DialogButtonPositive" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_button_positive</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DialogButtonNegative" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_button_negative</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DialogTitle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="DialogText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="AppBottomSheetStyle" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/AppBottomSheetShape</item>
        <item name="backgroundTint">@color/main_bg</item>
    </style>

    <style name="AppBottomSheetShape">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
    </style>

    <style name="AppSliderLabelStyle" parent="Widget.MaterialComponents.Tooltip">
        <item name="backgroundTint">@color/slider_label_bg</item>
        <item name="android:textAppearance">@style/AppSliderLabelTextAppearance</item>
    </style>

    <style name="AppSliderLabelTextAppearance" parent="TextAppearance.MaterialComponents.Tooltip">
        <item name="android:textColor">@color/slider_label_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>