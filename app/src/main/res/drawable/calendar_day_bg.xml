<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true" android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_selected_activated_fill" />
            <stroke android:width="2dp" android:color="@color/calendar_day_selected_activated_stroke" />
        </shape>
    </item>

    <item android:state_selected="true" android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_selected_hovered_fill" />
            <stroke android:width="2dp" android:color="@color/calendar_day_selected_hovered_stroke" />
        </shape>
    </item>

    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_selected_fill" />
            <stroke android:width="1dp" android:color="@color/calendar_day_selected_stroke" />
        </shape>
    </item>

    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_activated_fill" />
            <stroke android:width="2dp" android:color="@color/calendar_day_activated_stroke" />
        </shape>
    </item>

    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_hovered_fill" />
            <stroke android:width="2dp" android:color="@color/calendar_day_hovered_stroke" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/calendar_day_fill" />
            <stroke android:width="1dp" android:color="@color/calendar_day_stroke" />
        </shape>
    </item>

</selector>